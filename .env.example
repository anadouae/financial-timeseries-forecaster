# Copy to .env and fill in. Never commit real secrets.

# Required in production / docker-compose. When set, /predict needs
# header X-API-Key: <value>  OR  Authorization: Bearer <value>
# /health stays public.
FTS_API_KEY=change-me-to-a-long-random-secret

# Checkpoint served by the API
FTS_MODEL_PATH=artifacts/best_model.pt

# SQLite tracking store (default) or remote MLflow server URI
FTS_MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Optional overrides
# FTS_DEVICE=cpu
# FTS_HOST=0.0.0.0
# FTS_PORT=8000
# FTS_EXPERIMENT_NAME=volatility-lstm
